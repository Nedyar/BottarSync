# CurseForge packager: it packages every tagged commit pushed to GitHub.
# Files starting with a dot (.git, .github, this file...) are always left out.
package-as: BottarSync

# Bot holds the bot's readers (Node.js, Python) and the format's
# documentation: not part of the addon, and CurseForge allows no scripts of
# other kinds in a package.
ignore:
    - Tests
    - Bot

manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

# The CurseForge app installs these with the addon: each packaged file
# carries them as its required relations (project slugs).
required-dependencies:
    - lib-guild-sync
    - guild-professions-recipes
    - guild-bank-alts
